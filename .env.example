# Copy to .env for local overrides, or set this directly in Vercel's
# Project Settings → Environment Variables for production.

# Leave unset for local development — Vite's dev server proxies /api to
# your local backend automatically (see vite.config.js).
#
# For production on Vercel, set this to your Render backend's URL + "/api":
# VITE_API_URL=https://greenprint-api.onrender.com/api
VITE_API_URL=
